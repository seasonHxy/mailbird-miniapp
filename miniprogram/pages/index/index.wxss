.page { padding: 32rpx; }
.banner {
  background: linear-gradient(135deg, #4F63E6, #7A8BFF);
  border-radius: 24rpx;
  padding: 56rpx 36rpx;
  color: #fff;
}
.banner-title { font-size: 44rpx; font-weight: 800; }
.banner-sub { font-size: 26rpx; margin-top: 12rpx; opacity: 0.9; }

.section-title { font-size: 30rpx; font-weight: 600; margin: 40rpx 0 20rpx; }

.cat-list { display: flex; flex-direction: column; gap: 20rpx; }
.cat-card { display: flex; align-items: center; gap: 24rpx; border-radius: 20rpx; padding: 32rpx 28rpx; }
.cat-icon { font-size: 56rpx; }
.cat-info { flex: 1; }
.cat-name { font-size: 32rpx; font-weight: 700; }
.cat-desc { font-size: 24rpx; color: #6b7080; margin-top: 8rpx; }
.cat-arrow { font-size: 36rpx; font-weight: 700; }

.recent-list { display: flex; flex-direction: column; gap: 16rpx; }
.recent-item { display: flex; align-items: center; gap: 20rpx; }
.recent-icon { font-size: 40rpx; }
.recent-body { flex: 1; overflow: hidden; }
.recent-title { font-size: 28rpx; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.recent-meta { font-size: 22rpx; color: #9aa0b5; margin-top: 6rpx; }
