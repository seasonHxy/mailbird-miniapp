.page { padding: 32rpx; }
.hint { font-size: 26rpx; color: #9aa0b5; text-align: center; margin-bottom: 24rpx; }
.form { display: flex; flex-direction: column; gap: 32rpx; }
.field {}
.label { font-size: 28rpx; font-weight: 600; margin-bottom: 14rpx; }
.req { color: #e0452f; }
.input, .textarea {
  background: #F5F6FA;
  border-radius: 14rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  width: auto;
}
.textarea { min-height: 120rpx; width: auto; }
.ph { color: #b6bac8; }
.tone-row { display: flex; gap: 20rpx; }
.tone {
  flex: 1; text-align: center; font-size: 28rpx;
  padding: 16rpx 0; border-radius: 12rpx;
  background: #F5F6FA; color: #6b7080;
  border: 2rpx solid transparent;
}
.tone-active { background: #EEF1FE; color: #4F63E6; border-color: #4F63E6; font-weight: 600; }
.switch-row { display: flex; align-items: center; justify-content: space-between; }
.switch-row .label { margin-bottom: 0; }
.submit { margin-top: 40rpx; }
